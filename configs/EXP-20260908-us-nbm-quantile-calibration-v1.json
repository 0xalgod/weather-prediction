  },
  "models": {
    "market": "normalized indicative 18-hour YES vector",
    "uniform": "equal probability across native buckets",
    "raw_nbm_quantile": "piecewise-linear quantile-preserving CDF; 1F precision; 1F minimum tail width",
    "calibrated_nbm_quantile": "development-selected common shift and spread scale applied around NBM median",
    "challenger": "fixed 0.50 market plus 0.50 calibrated NBM quantile"
  },
  "calibration_grid": {
