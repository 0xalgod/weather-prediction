  "hypothesis": "A city-agnostic development-fitted shift/spread calibration of NBM quantiles, blended 50/50 with 18-hour market probabilities, improves validation log loss by at least 2% versus the market alone without worsening Brier score; only then may it be evaluated once on the untouched test dates.",
  "eligibility": {
    "required_price_status": "PRICE_ELIGIBLE",
    "expected_event_count": 187,
    "expected_date_cluster_count": 17
  },
  "temporal_split": {
