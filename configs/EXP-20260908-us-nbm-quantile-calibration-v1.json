    "validation_dates": ["2026-06-25", "2026-07-02", "2026-07-10", "2026-07-17"],
    "test_dates": ["2026-07-24", "2026-08-01", "2026-08-08", "2026-08-15"],
    "expected_counts": {"development": 99, "validation": 44, "test": 44},
