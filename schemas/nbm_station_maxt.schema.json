{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weather-quant.local/schemas/nbm_station_maxt.schema.json",
  "title": "NBM station maximum-temperature probabilistic record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "station_code",
    "nbm_version",
    "model_run_time_utc",
    "forecast_hour",
    "valid_time_utc",
    "temperature_kind",
    "temperature_unit",
    "mean_f",
    "standard_deviation_f",
    "p10_f",
    "p25_f",
    "p50_f",
    "p75_f",
    "p90_f",
    "source_sha256",
    "source_http_last_modified",
    "ingested_at_utc"
  ],
  "properties": {
    "station_code": {"type": "string", "pattern": "^[A-Z0-9]{4}$"},
    "nbm_version": {"type": "string"},
    "model_run_time_utc": {"type": "string", "format": "date-time"},
    "forecast_hour": {"type": "integer", "minimum": 0},
    "valid_time_utc": {"type": "string", "format": "date-time"},
    "temperature_kind": {"const": "MAXIMUM"},
    "temperature_unit": {"const": "F"},
    "mean_f": {"type": ["integer", "null"]},
    "standard_deviation_f": {"type": ["integer", "null"], "minimum": 0},
    "p10_f": {"type": ["integer", "null"]},
    "p25_f": {"type": ["integer", "null"]},
    "p50_f": {"type": ["integer", "null"]},
    "p75_f": {"type": ["integer", "null"]},
    "p90_f": {"type": ["integer", "null"]},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_http_last_modified": {"type": "string"},
    "ingested_at_utc": {"type": "string", "format": "date-time"}
  }
}
